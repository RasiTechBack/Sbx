NODE_ENV=production
PORT=3001
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string
REQUIRE_JWT_SECRET=true
CORS_ORIGIN=http://202.10.34.119,http://localhost:5173

# Optional: lock public registration behind invite code
INVITE_ONLY_REGISTER=false
REGISTER_INVITE_CODE=

# B2B company signup → notify RasiTech support (admin verifies in Settings → Accounts)
SUPPORT_EMAIL=support@rasitech.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CredSeek <support@rasitech.org>

DATABASE_URL=postgres://credseek:credseek@127.0.0.1:5432/credseek
REDIS_URL=redis://127.0.0.1:6379

# Pause all imports when SQLite on-disk size (db+WAL) reaches this ceiling.
# VPS ~80GB disk → keep headroom with 70GB default. Override in Settings → Data.
MAX_DB_GB=70

# Subscription / QRIS (Saweria bridge)
SAWERIA_CREATE_URL=https://rasitech.org/saweria/
SAWERIA_CHECK_URL=https://rasitech.org/saweria/cek.php
SUBSCRIPTION_POLL=1
SUBSCRIPTION_POLL_MS=20000
# Optional JSON array override for plans:
# SUBSCRIPTION_PACKAGES_JSON=[{"id":"starter","name":"Starter","description":"...","priceIdr":25000,"durationDays":30,"features":["Full search"]}]

# sqlite (default, current VPS) or opensearch (scale path)
SEARCH_BACKEND=sqlite
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=credentials
OPENSEARCH_SHARDS=3
OPENSEARCH_REPLICAS=0

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=credseek-imports

API_INSTANCES=2
IMPORT_INSTANCES=1
POSTGRES_PASSWORD=credseek

# Runtime / PM2 guards (3–4GB VPS defaults)
PM2_MAX_MEMORY=1400M
NODE_OPTIONS=--max-old-space-size=1280
GUARD_MAX_RSS_MB=1500
GUARD_MAX_HEAP_MB=1200
GUARD_MAX_LOOP_MS=5000
GUARD_WATCH_MS=30000
GUARD_HEALTH_TIMEOUT_MS=12000
GUARD_FAIL_STREAK=2
GUARD_COOLDOWN_MS=120000
GUARD_MIN_AVAIL_MEM_MB=200
GUARD_MAX_TEMP_C=90

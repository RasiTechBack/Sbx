{
  "name": "credseek",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "seed:users": "tsx server/seed-users.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "worker:import": "tsx server/workers/importWorker.ts",
    "guard": "tsx server/workers/healthGuard.ts",
    "migrate:opensearch": "tsx server/scripts/migrateSqliteToOpenSearch.ts",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.9.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "playwright": "^1.58.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.15.2",
    "stream-json": "^3.8.0",
    "teleproto": "^1.233.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/stream-json": "^1.7.8",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
